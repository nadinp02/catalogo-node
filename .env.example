# Variables de entorno del proyecto.
# Copiar a .env.local para desarrollo local (ese archivo no se sube a git).
# En producción se definen en Vercel → Project Settings → Environment Variables.

# Postgres (Neon). Usar la connection string DIRECTA (no la "pooled"/PgBouncer):
# "prisma migrate dev" no es compatible con el modo transacción del pooler.
# Formato: postgresql://user:password@host/db?sslmode=require
DATABASE_URL=

# Auth.js
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Cloudinary (gestión de imágenes de productos). Datos del dashboard de
# Cloudinary → Product Environment Credentials. Nunca se exponen al cliente
# (sin prefijo NEXT_PUBLIC_): el navegador sube directo a Cloudinary con una
# firma que genera un Server Action, no con estas credenciales.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# WhatsApp comercial. Número completo en formato internacional, SOLO
# dígitos: código de país + área + número, sin "+", espacios ni guiones.
# Ej: Argentina, celular de Buenos Aires 11-2233-4455 -> 5491122334455
#   54  = código de país (Argentina)
#   9   = prefijo obligatorio para celulares en WhatsApp
#   11  = código de área (Buenos Aires)
#   22334455 = número
WHATSAPP_NUMBER=
# Nombre visible en el header/footer del catálogo público.
COMPANY_NAME=
# Opcional. Si se deja vacío, el link de Instagram no se muestra en el footer.
INSTAGRAM_URL=
