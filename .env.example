# Variables de entorno del proyecto.
# Copiar a .env.local para desarrollo local (ese archivo no se sube a git).
#
# En esta fase (validación de infraestructura) no hay variables requeridas.
# Cuando integremos Prisma + MySQL, acá se va a agregar DATABASE_URL, etc.

# Puerto en el que corre el servidor. En Duplika/cPanel esta variable la
# inyecta Passenger automáticamente: NO hay que definirla a mano en producción.
PORT=3000

